# Café business app. This app creates and sends invoices.
# PayPal Dashboard → Apps & Credentials → Sandbox → your café app.
CAFE_PAYPAL_CLIENT_ID=
CAFE_PAYPAL_CLIENT_SECRET=
# Optional. Omit unless PayPal rejects the invoice for a missing invoicer.
CAFE_MERCHANT_EMAIL=

# Supplier business app. A different sandbox business account.
# Orders are created with these credentials, so the capture pays this account.
SUPPLIER_PAYPAL_CLIENT_ID=
SUPPLIER_PAYPAL_CLIENT_SECRET=

# Sandbox personal account that pays the café invoice.
# Use this address as the invoice recipient. Log into it in a second browser profile.
CLIENT_PAYER_EMAIL=

# How purchase requests are read.
#   auto: use the model when LLM_API_KEY is set, otherwise the mock reader (default)
#   mock: always use the deterministic mock reader, even if a key is set
#   llm:  use the model; falls back to the mock reader, with a warning, if the key is empty
AI_MODE=auto

# OpenAI-compatible chat endpoint. Groq, OpenAI, and Gemini's compatible endpoint all work.
# The endpoint must accept response_format {"type": "json_object"}.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

STARTING_CASH_CENTS=2000
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
